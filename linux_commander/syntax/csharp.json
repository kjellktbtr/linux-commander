        },
        {
            "regex": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?[FfDdMm]?\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "@\"(\"\"|[^\"])*\"",
            "color": "#ce9178"
        },
        {
            "regex": "\"(\\\\.|[^\"\\\\])*\"",
            "color": "#ce9178"
        },
        {
            "regex": "'(\\\\.|[^\\\\'])'",
            "color": "#ce9178"
        },
        {
            "regex": "@[A-Za-z_][A-Za-z0-9_]*",
            "color": "#dcdcaa"
        }
