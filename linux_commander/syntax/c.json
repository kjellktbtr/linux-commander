{
    "name": "C",
    "extensions": [
        ".c",
        ".h",
        ".cpp",
        ".hpp",
        ".cc",
        ".cxx",
        ".hh"
    ],
    "case_sensitive": true,
    "keywords": {
        "auto": "#569cd6",
        "break": "#569cd6",
        "case": "#569cd6",
        "const": "#569cd6",
        "continue": "#569cd6",
        "default": "#569cd6",
        "do": "#569cd6",
        "else": "#569cd6",
        "enum": "#569cd6",
        "extern": "#569cd6",
        "for": "#569cd6",
        "goto": "#569cd6",
        "if": "#569cd6",
        "inline": "#569cd6",
        "register": "#569cd6",
        "restrict": "#569cd6",
        "return": "#569cd6",
        "sizeof": "#569cd6",
        "static": "#569cd6",
        "struct": "#569cd6",
        "switch": "#569cd6",
        "typedef": "#569cd6",
        "union": "#569cd6",
        "volatile": "#569cd6",
        "while": "#569cd6",
        "__attribute__": "#569cd6"
    },
    "types": {
        "int": "#4ec9b0",
        "long": "#4ec9b0",
        "short": "#4ec9b0",
        "char": "#4ec9b0",
        "float": "#4ec9b0",
        "double": "#4ec9b0",
        "void": "#4ec9b0",
        "signed": "#4ec9b0",
        "unsigned": "#4ec9b0",
        "bool": "#4ec9b0",
        "size_t": "#4ec9b0",
        "ssize_t": "#4ec9b0",
        "uint8_t": "#4ec9b0",
        "uint16_t": "#4ec9b0",
        "uint32_t": "#4ec9b0",
        "uint64_t": "#4ec9b0",
        "int8_t": "#4ec9b0",
        "int16_t": "#4ec9b0",
        "int32_t": "#4ec9b0",
        "int64_t": "#4ec9b0",
        "FILE": "#4ec9b0",
        "NULL": "#4ec9b0"
    },
    "preprocessor": {
        "#include": "#9b9b9b",
        "#define": "#9b9b9b",
        "#undef": "#9b9b9b",
        "#ifdef": "#9b9b9b",
        "#ifndef": "#9b9b9b",
        "#if": "#9b9b9b",
        "#else": "#9b9b9b",
        "#elif": "#9b9b9b",
        "#endif": "#9b9b9b",
        "#pragma": "#9b9b9b",
        "#error": "#9b9b9b"
    },
    "symbols": {
        "->": "#dcdcaa",
        ".": "#dcdcaa",
        ",": "#d4d4d4",
        ";": "#d4d4d4",
        "(": "#d4d4d4",
        ")": "#d4d4d4",
        "{": "#d4d4d4",
        "}": "#d4d4d4",
        "[": "#d4d4d4",
        "]": "#d4d4d4"
    },
    "string_color": "#ce9178",
    "comment_color": "#6a9955",
    "number_color": "#b5cea8",
    "line_comment": "//"
