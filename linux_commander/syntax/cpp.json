    "patterns": [
        {
            "regex": "\\b0[xX][0-9a-fA-F]+[UuLl]*\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\\b[0-9]+[UuLl]*\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?[FfLl]?\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\"(\\\\.|[^\"\\\\])*\"",
            "color": "#ce9178"
        },
        {
            "regex": "'(\\\\.|[^\\\\'])'",
            "color": "#ce9178"
        },
        {
            "regex": "R\"[^)]*\\([^)]*\\)[^)]*\"",
            "color": "#ce9178",
            "multiline": true
        },
        {
            "regex": "#[^\n]*",
            "color": "#c586c0"
        }
    ]
