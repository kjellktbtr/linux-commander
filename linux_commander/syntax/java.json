    "patterns": [
        {
            "regex": "\\b0[xX][0-9a-fA-F]+\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?[fFdD]?\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "@[A-Za-z_][A-Za-z0-9_]*",
            "color": "#dcdcaa"
        }
    ]
