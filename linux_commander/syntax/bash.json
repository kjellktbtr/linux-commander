{
    "name": "Bash",
    "extensions": [".sh", ".bash"],
    "case_sensitive": true,
    "keywords": {
        "if": "#569cd6",
        "then": "#569cd6",
        "else": "#569cd6",
        "elif": "#569cd6",
        "fi": "#569cd6",
        "for": "#569cd6",
        "in": "#569cd6",
        "do": "#569cd6",
        "done": "#569cd6",
        "while": "#569cd6",
        "until": "#569cd6",
        "case": "#569cd6",
        "esac": "#569cd6",
        "select": "#569cd6",
        "function": "#569cd6",
        "return": "#569cd6",
        "break": "#569cd6",
        "continue": "#569cd6",
        "exit": "#569cd6",
        "shift": "#569cd6",
        "export": "#569cd6",
        "local": "#569cd6",
        "readonly": "#569cd6",
        "unset": "#569cd6",
        "declare": "#569cd6",
        "typeset": "#569cd6",
        "source": "#569cd6",
        "trap": "#569cd6",
        "exec": "#569cd6",
        "eval": "#569cd6",
        "set": "#569cd6",
        "shopt": "#569cd6"
    },
    "builtins": {
        "echo": "#dcdcaa",
        "printf": "#dcdcaa",
        "read": "#dcdcaa",
        "test": "#dcdcaa",
        "true": "#dcdcaa",
        "false": "#dcdcaa",
        "cd": "#dcdcaa",
        "pwd": "#dcdcaa",
        "ls": "#dcdcaa",
        "mkdir": "#dcdcaa",
        "rm": "#dcdcaa",
        "cp": "#dcdcaa",
        "mv": "#dcdcaa",
        "cat": "#dcdcaa",
        "grep": "#dcdcaa",
        "sed": "#dcdcaa",
        "awk": "#dcdcaa",
        "find": "#dcdcaa",
        "sort": "#dcdcaa",
        "cut": "#dcdcaa",
        "wc": "#dcdcaa",
        "head": "#dcdcaa",
        "tail": "#dcdcaa"
    },
    "string_color": "#ce9178",
    "comment_color": "#6a9955",
    "number_color": "#b5cea8",
    "line_comment": "#",
    "patterns": [
        {"regex": "\\$\\{?[A-Za-z_][A-Za-z0-9_]*\\}?", "color": "#9cdcfe", "multiline": false},
        {"regex": "\\$[0-9@*#?$!]", "color": "#9cdcfe", "multiline": false}
    ]
}
