{
    "name": "Python",
    "extensions": [
        ".py",
        ".pyw",
        ".pyx"
    ],
    "case_sensitive": true,
    "keywords": {
        "False": "#569cd6",
        "None": "#569cd6",
        "True": "#569cd6",
        "and": "#569cd6",
        "as": "#569cd6",
        "assert": "#569cd6",
        "async": "#569cd6",
        "await": "#569cd6",
        "break": "#569cd6",
        "class": "#569cd6",
        "continue": "#569cd6",
        "def": "#569cd6",
        "del": "#569cd6",
        "elif": "#569cd6",
        "else": "#569cd6",
        "except": "#569cd6",
        "finally": "#569cd6",
        "for": "#569cd6",
        "from": "#569cd6",
        "global": "#569cd6",
        "if": "#569cd6",
        "import": "#569cd6",
        "in": "#569cd6",
        "is": "#569cd6",
        "lambda": "#569cd6",
        "nonlocal": "#569cd6",
        "not": "#569cd6",
        "or": "#569cd6",
        "pass": "#569cd6",
        "raise": "#569cd6",
        "return": "#569cd6",
        "try": "#569cd6",
        "while": "#569cd6",
        "with": "#569cd6",
        "yield": "#569cd6"
    },
    "builtins": {
        "print": "#dcdcaa",
        "len": "#dcdcaa",
        "range": "#dcdcaa",
        "int": "#dcdcaa",
        "float": "#dcdcaa",
        "str": "#dcdcaa",
        "list": "#dcdcaa",
        "dict": "#dcdcaa",
        "set": "#dcdcaa",
        "tuple": "#dcdcaa",
        "bool": "#dcdcaa",
        "type": "#dcdcaa",
        "isinstance": "#dcdcaa",
        "hasattr": "#dcdcaa",
        "getattr": "#dcdcaa",
        "setattr": "#dcdcaa",
        "open": "#dcdcaa",
        "super": "#dcdcaa",
        "self": "#dcdcaa",
        "__init__": "#dcdcaa",
        "__str__": "#dcdcaa",
        "__repr__": "#dcdcaa",
        "__call__": "#dcdcaa",
        "__name__": "#dcdcaa",
        "__main__": "#dcdcaa"
    },
    "symbols": {
        "->": "#dcdcaa",
        ".": "#dcdcaa",
        ",": "#d4d4d4",
        ":": "#d4d4d4",
        ";": "#d4d4d4",
        "(": "#d4d4d4",
        ")": "#d4d4d4",
        "{": "#d4d4d4",
        "}": "#d4d4d4",
        "[": "#d4d4d4",
        "]": "#d4d4d4",
        "@": "#dcdcaa"
    },
    "string_color": "#ce9178",
    "comment_color": "#6a9955",
    "number_color": "#b5cea8",
    "line_comment": "#"
}