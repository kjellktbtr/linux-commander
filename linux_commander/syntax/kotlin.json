{
    "name": "Kotlin",
    "extensions": [
        ".kt",
        ".kts",
        ".ktm"
    ],
    "case_sensitive": true,
    "keywords": {
        "as": "#569cd6",
        "as?": "#569cd6",
        "break": "#569cd6",
        "class": "#569cd6",
        "continue": "#569cd6",
        "do": "#569cd6",
        "else": "#569cd6",
        "false": "#569cd6",
        "for": "#569cd6",
        "fun": "#569cd6",
        "if": "#569cd6",
        "in": "#569cd6",
        "!in": "#569cd6",
        "interface": "#569cd6",
        "is": "#569cd6",
        "!is": "#569cd6",
        "null": "#569cd6",
        "object": "#569cd6",
        "package": "#569cd6",
        "return": "#569cd6",
        "super": "#569cd6",
        "this": "#569cd6",
        "throw": "#569cd6",
        "true": "#569cd6",
        "try": "#569cd6",
        "typealias": "#569cd6",
        "typeof": "#569cd6",
        "val": "#569cd6",
        "var": "#569cd6",
        "when": "#569cd6",
        "while": "#569cd6",
        "by": "#569cd6",
        "catch": "#569cd6",
        "constructor": "#569cd6",
        "delegate": "#569cd6",
        "dynamic": "#569cd6",
        "field": "#569cd6",
        "file": "#569cd6",
        "finally": "#569cd6",
        "get": "#569cd6",
        "import": "#569cd6",
        "init": "#569cd6",
        "param": "#569cd6",
        "property": "#569cd6",
        "receiver": "#569cd6",
        "set": "#569cd6",
        "setparam": "#569cd6",
        "where": "#569cd6",
        "actual": "#569cd6",
        "abstract": "#569cd6",
        "annotation": "#569cd6",
        "companion": "#569cd6",
        "const": "#569cd6",
        "crossinline": "#569cd6",
        "data": "#569cd6",
        "enum": "#569cd6",
        "expect": "#569cd6",
        "external": "#569cd6",
        "final": "#569cd6",
        "infix": "#569cd6",
        "inline": "#569cd6",
        "inner": "#569cd6",
        "internal": "#569cd6",
        "lateinit": "#569cd6",
        "noinline": "#569cd6",
        "open": "#569cd6",
        "operator": "#569cd6",
        "out": "#569cd6",
        "override": "#569cd6",
        "private": "#569cd6",
        "protected": "#569cd6",
        "public": "#569cd6",
        "reified": "#569cd6",
        "sealed": "#569cd6",
        "suspend": "#569cd6",
        "tailrec": "#569cd6",
        "vararg": "#569cd6"
    },
    "builtins": {
        "String": "#4ec9b0",
        "Int": "#4ec9b0",
        "Long": "#4ec9b0",
        "Double": "#4ec9b0",
        "Float": "#4ec9b0",
        "Boolean": "#4ec9b0",
        "Array": "#4ec9b0",
        "List": "#4ec9b0",
        "Set": "#4ec9b0",
        "Map": "#4ec9b0",
        "MutableList": "#4ec9b0",
        "MutableSet": "#4ec9b0",
        "MutableMap": "#4ec9b0",
        "Any": "#4ec9b0",
        "Unit": "#4ec9b0",
        "Nothing": "#4ec9b0",
        "Pair": "#4ec9b0",
        "Triple": "#4ec9b0",
        "println": "#dcdcaa",
        "print": "#dcdcaa",
        "readLine": "#dcdcaa",
        "require": "#dcdcaa",
        "check": "#dcdcaa",
        "error": "#dcdcaa",
        "TODO": "#dcdcaa",
        "main": "#dcdcaa",
        "run": "#dcdcaa",
        "let": "#dcdcaa",
        "apply": "#dcdcaa",
        "also": "#dcdcaa",
        "takeIf": "#dcdcaa",
        "takeUnless": "#dcdcaa"
    },
    "types": {
        "Byte": "#4ec9b0",
        "Short": "#4ec9b0",
        "Int": "#4ec9b0",
        "Long": "#4ec9b0",
        "Float": "#4ec9b0",
        "Double": "#4ec9b0",
        "Boolean": "#4ec9b0",
        "Char": "#4ec9b0",
        "String": "#4ec9b0",
        "Unit": "#4ec9b0"
    },
    "string_color": "#ce9178",
    "comment_color": "#6a9955",
    "number_color": "#b5cea8",
    "line_comment": "//",
    "patterns": [
        {
            "regex": "\\b0[xX][0-9a-fA-F]+[Ll]?\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\\b0[bB][01]+[Ll]?\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?[FfDd]?\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\"(\\\\.|[^\"\\\\])*\"",
            "color": "#ce9178"
        },
        {
            "regex": "'''[\\s\\S]*?'''",
            "color": "#ce9178",
            "multiline": true
        },
        {
            "regex": "@[A-Za-z_][A-Za-z0-9_]*",
            "color": "#dcdcaa"
        }
    ]
}