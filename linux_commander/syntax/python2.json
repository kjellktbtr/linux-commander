        "__repr__": "#dcdcaa",
        "__call__": "#dcdcaa",
        "__name__": "#dcdcaa",
        "__main__": "#dcdcaa"
    },
    "symbols": {
        "->": "#dcdcaa",
        ".": "#dcdcaa",
        ",": "#d4d4d4",
        ":": "#d4d4d4",
        ";": "#d4d4d4",
        "(": "#d4d4d4",
        ")": "#d4d4d4",
        "{": "#d4d4d4",
        "}": "#d4d4d4",
        "[": "#d4d4d4",
        "]": "#d4d4d4",
        "@": "#dcdcaa"
    },
    "string_color": "#ce9178",
    "comment_color": "#6a9955",
    "number_color": "#b5cea8",
    "line_comment": "#",
    "patterns": [
        {
            "regex": "\\b0[xX][0-9a-fA-F]+[lL]?\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\\b0[oO][0-7]+[lL]?\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\\b0[bB][01]+[lL]?\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?[jJ]?\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "(r|u|ur|b|br)?\"([^\"\\\\]|\\\\.)*\"",
            "color": "#ce9178"
        },
        {
            "regex": "(r|u|ur|b|br)?'([^'\\\\]|\\\\.)*'",
            "color": "#ce9178"
        },
        {
            "regex": "(r|u|ur|b|br)?\"\"\"[\\s\\S]*?\"\"\"",
            "color": "#ce9178"
        },
        {
            "regex": "(r|u|ur|b|br)?'''[\\s\\S]*?'''",
            "color": "#ce9178"
        }
    ]
}