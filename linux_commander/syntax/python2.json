{
    "name": "Python 2",
    "extensions": [
        ".py",
        ".pyw"
    ],
    "case_sensitive": true,
    "keywords": {
        "and": "#569cd6",
        "as": "#569cd6",
        "assert": "#569cd6",
        "break": "#569cd6",
        "class": "#569cd6",
        "continue": "#569cd6",
