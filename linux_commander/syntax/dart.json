{
    "name": "Dart",
    "extensions": [
        ".dart"
    ],
    "case_sensitive": true,
    "keywords": {
        "assert": "#569cd6",
        "break": "#569cd6",
        "case": "#569cd6",
        "catch": "#569cd6",
        "class": "#569cd6",
        "const": "#569cd6",
        "continue": "#569cd6",
        "default": "#569cd6",
        "do": "#569cd6",
        "else": "#569cd6",
        "enum": "#569cd6",
        "extends": "#569cd6",
        "false": "#569cd6",
        "final": "#569cd6",
        "finally": "#569cd6",
        "for": "#569cd6",
        "if": "#569cd6",
        "in": "#569cd6",
        "is": "#569cd6",
        "new": "#569cd6",
        "null": "#569cd6",
        "rethrow": "#569cd6",
        "return": "#569cd6",
        "super": "#569cd6",
        "switch": "#569cd6",
        "this": "#569cd6",
        "throw": "#569cd6",
        "true": "#569cd6",
        "try": "#569cd6",
        "var": "#569cd6",
        "void": "#569cd6",
        "while": "#569cd6",
        "with": "#569cd6",
        "async": "#569cd6",
        "await": "#569cd6",
        "yield": "#569cd6",
        "sync": "#569cd6",
        "abstract": "#569cd6",
        "implements": "#569cd6",
        "interface": "#569cd6",
        "mixin": "#569cd6",
        "on": "#569cd6",
        "part": "#569cd6",
        "required": "#569cd6",
        "show": "#569cd6",
        "hide": "#569cd6",
        "library": "#569cd6",
        "import": "#569cd6",
        "export": "#569cd6",
        "deferred": "#569cd6",
        "as": "#569cd6",
        "covariant": "#569cd6",
        "external": "#569cd6",
        "factory": "#569cd6",
        "get": "#569cd6",
        "set": "#569cd6",
        "static": "#569cd6",
        "operator": "#569cd6",
        "typedef": "#569cd6"
    },
    "builtins": {
        "print": "#dcdcaa",
        "String": "#4ec9b0",
        "int": "#4ec9b0",
        "double": "#4ec9b0",
        "bool": "#4ec9b0",
        "List": "#4ec9b0",
        "Set": "#4ec9b0",
        "Map": "#4ec9b0",
        "DateTime": "#4ec9b0",
        "Duration": "#4ec9b0",
        "Future": "#4ec9b0",
        "Stream": "#4ec9b0",
        "Iterable": "#4ec9b0",
        "Iterator": "#4ec9b0",
        "num": "#4ec9b0",
        "Object": "#4ec9b0",
        "RegExp": "#4ec9b0",
        "Type": "#4ec9b0",
        "Error": "#4ec9b0",
        "Exception": "#4ec9b0",
        "StackTrace": "#4ec9b0",
        "main": "#dcdcaa",
        "identical": "#dcdcaa",
        "identityHashCode": "#dcdcaa"
    },
    "types": {
        "int": "#4ec9b0",
        "double": "#4ec9b0",
        "bool": "#4ec9b0",
        "String": "#4ec9b0",
        "dynamic": "#4ec9b0",
        "void": "#4ec9b0",
        "Future": "#4ec9b0",
        "Stream": "#4ec9b0",
        "Iterable": "#4ec9b0",
        "List": "#4ec9b0",
        "Set": "#4ec9b0",
        "Map": "#4ec9b0"
    },
    "string_color": "#ce9178",
    "comment_color": "#6a9955",
    "number_color": "#b5cea8",
    "line_comment": "//",
    "patterns": [
        {
            "regex": "\\b0[xX][0-9a-fA-F]+\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\"(\\\\.|[^\"\\\\])*\"",
            "color": "#ce9178"
        },
        {
            "regex": "'(\\\\.|[^\\\\'])*'",
            "color": "#ce9178"
        },
        {
            "regex": "r\"(\\\\.|[^\"\\\\])*\"",
            "color": "#ce9178"
        },
        {
            "regex": "@[A-Za-z_][A-Za-z0-9_]*",
            "color": "#dcdcaa"
        }
    ]
}