{
    "name": "JavaScript",
    "extensions": [
        ".js",
        ".jsx",
        ".mjs",
        ".cjs"
    ],
    "case_sensitive": true,
    "keywords": {
        "break": "#569cd6",
        "case": "#569cd6",
        "catch": "#569cd6",
        "class": "#569cd6",
        "const": "#569cd6",
        "continue": "#569cd6",
        "debugger": "#569cd6",
        "default": "#569cd6",
        "delete": "#569cd6",
        "do": "#569cd6",
        "else": "#569cd6",
        "export": "#569cd6",
        "extends": "#569cd6",
        "finally": "#569cd6",
        "for": "#569cd6",
        "function": "#569cd6",
        "if": "#569cd6",
        "import": "#569cd6",
        "in": "#569cd6",
        "instanceof": "#569cd6",
        "new": "#569cd6",
        "return": "#569cd6",
        "super": "#569cd6",
        "switch": "#569cd6",
        "this": "#569cd6",
        "throw": "#569cd6",
        "try": "#569cd6",
        "typeof": "#569cd6",
        "var": "#569cd6",
        "void": "#569cd6",
        "while": "#569cd6",
        "with": "#569cd6",
        "yield": "#569cd6",
        "let": "#569cd6",
        "static": "#569cd6",
        "enum": "#569cd6",
        "await": "#569cd6",
        "implements": "#569cd6",
        "interface": "#569cd6",
        "package": "#569cd6",
        "private": "#569cd6",
        "protected": "#569cd6",
        "public": "#569cd6",
        "null": "#569cd6",
        "true": "#569cd6",
        "false": "#569cd6",
        "async": "#569cd6",
        "of": "#569cd6",
        "from": "#569cd6",
        "as": "#569cd6",
        "get": "#569cd6",
        "set": "#569cd6"
    },
    "builtins": {
        "console": "#dcdcaa",
        "window": "#dcdcaa",
        "document": "#dcdcaa",
        "Array": "#4ec9b0",
        "Object": "#4ec9b0",
        "String": "#4ec9b0",
        "Number": "#4ec9b0",
        "Boolean": "#4ec9b0",
        "Date": "#4ec9b0",
        "RegExp": "#4ec9b0",
        "Promise": "#4ec9b0",
        "Map": "#4ec9b0",
        "Set": "#4ec9b0",
        "WeakMap": "#4ec9b0",
        "WeakSet": "#4ec9b0",
        "JSON": "#dcdcaa",
        "Math": "#dcdcaa",
        "parseInt": "#dcdcaa",
        "parseFloat": "#dcdcaa",
        "isNaN": "#dcdcaa",
        "isFinite": "#dcdcaa",
        "encodeURI": "#dcdcaa",
        "decodeURI": "#dcdcaa",
        "encodeURIComponent": "#dcdcaa",
        "decodeURIComponent": "#dcdcaa",
        "setTimeout": "#dcdcaa",
        "setInterval": "#dcdcaa",
        "clearTimeout": "#dcdcaa",
        "clearInterval": "#dcdcaa",
        "undefined": "#569cd6",
        "NaN": "#569cd6",
        "Infinity": "#569cd6",
        "globalThis": "#569cd6",
        "global": "#569cd6",
        "require": "#dcdcaa",
        "module": "#dcdcaa",
        "exports": "#dcdcaa",
        "process": "#dcdcaa",
        "Buffer": "#4ec9b0"
    },
    "string_color": "#ce9178",
    "comment_color": "#6a9955",
    "number_color": "#b5cea8",
    "line_comment": "//",
    "patterns": [
        {
            "regex": "\\b0[xX][0-9a-fA-F]+\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "/[^/\\n]*[gimuy]?",
            "color": "#ce9178"
        },
        {
            "regex": "`[^`]*`",
            "color": "#ce9178"
        }
    ]
}