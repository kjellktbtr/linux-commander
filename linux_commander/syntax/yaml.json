{
    "name": "YAML",
    "extensions": [".yaml", ".yml"],
    "case_sensitive": false,
    "line_comment": "#",
    "keywords": {
        "true": "#569cd6",
        "false": "#569cd6",
        "null": "#569cd6",
        "yes": "#569cd6",
        "no": "#569cd6",
        "on": "#569cd6",
        "off": "#569cd6"
    },
    "patterns": [
        {"regex": "^\\s*[\\w.-]+\\s*:", "color": "#9cdcfe", "multiline": true},
        {"regex": "^\\s*-\\s", "color": "#c586c0", "multiline": true}
    ],
    "string_color": "#ce9178",
    "number_color": "#b5cea8",
    "comment_color": "#6a9955"
}
