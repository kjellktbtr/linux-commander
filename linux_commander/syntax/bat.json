{
    "name": "Batch",
    "extensions": [".bat", ".cmd"],
    "case_sensitive": false,
    "keywords": {},
    "string_color": "#ce9178",
    "comment_color": "#6a9955",
    "number_color": "#b5cea8",
    "line_comment": "::",
    "patterns": [
        {"regex": "^\\s*(?i:rem)\\b.*$", "color": "#6a9955", "multiline": true},
        {"regex": "(?i:\\becho\\b)", "color": "#dcdcaa", "multiline": false},
        {"regex": "(?i:\\bif\\b)", "color": "#569cd6", "multiline": false},
        {"regex": "(?i:\\belse\\b)", "color": "#569cd6", "multiline": false},
        {"regex": "(?i:\\bfor\\b)", "color": "#569cd6", "multiline": false},
        {"regex": "(?i:\\bgoto\\b)", "color": "#569cd6", "multiline": false},
        {"regex": "(?i:\\bcall\\b)", "color": "#569cd6", "multiline": false},
        {"regex": "(?i:\\bset\\b)", "color": "#569cd6", "multiline": false},
        {"regex": "(?i:\\bdo\\b)", "color": "#569cd6", "multiline": false},
        {"regex": "(?i:\\bin\\b)", "color": "#569cd6", "multiline": false},
        {"regex": "(?i:\\bexit\\b)", "color": "#569cd6", "multiline": false},
        {"regex": "(?i:\\bpause\\b)", "color": "#569cd6", "multiline": false},
        {"regex": "(?i:\\bstart\\b)", "color": "#dcdcaa", "multiline": false},
        {"regex": "(?i:\\bcmd\\b)", "color": "#dcdcaa", "multiline": false},
        {"regex": "(?i:\\bdel\\b)", "color": "#dcdcaa", "multiline": false},
        {"regex": "(?i:\\bcopy\\b)", "color": "#dcdcaa", "multiline": false},
        {"regex": "(?i:\\bmove\\b)", "color": "#dcdcaa", "multiline": false},
        {"regex": "(?i:\\bdir\\b)", "color": "#dcdcaa", "multiline": false},
        {"regex": "(?i:\\bcd\\b)", "color": "#dcdcaa", "multiline": false},
        {"regex": "%[A-Za-z_][A-Za-z0-9_]*%", "color": "#9cdcfe", "multiline": false},
        {"regex": "%~?[0-9]", "color": "#9cdcfe", "multiline": false},
        {"regex": "^:[A-Za-z_][A-Za-z0-9_]*", "color": "#c586c0", "multiline": true}
    ]
}
