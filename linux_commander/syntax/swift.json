    "builtins": {
        "String": "#4ec9b0",
        "Int": "#4ec9b0",
        "Double": "#4ec9b0",
        "Float": "#4ec9b0",
        "Bool": "#4ec9b0",
        "Array": "#4ec9b0",
        "Dictionary": "#4ec9b0",
        "Set": "#4ec9b0",
        "Optional": "#4ec9b0",
        "Any": "#4ec9b0",
        "AnyObject": "#4ec9b0",
        "print": "#dcdcaa",
        "debugPrint": "#dcdcaa",
        "fatalError": "#dcdcaa",
        "assert": "#dcdcaa",
        "precondition": "#dcdcaa",
        "min": "#dcdcaa",
        "max": "#dcdcaa",
        "abs": "#dcdcaa",
        "sqrt": "#dcdcaa",
        "pow": "#dcdcaa",
        "sin": "#dcdcaa",
        "cos": "#dcdcaa",
        "tan": "#dcdcaa",
        "log": "#dcdcaa",
        "exp": "#dcdcaa",
        "floor": "#dcdcaa",
        "ceil": "#dcdcaa",
        "round": "#dcdcaa"
    },
    "string_color": "#ce9178",
    "comment_color": "#6a9955",
    "number_color": "#b5cea8",
    "line_comment": "//",
    "patterns": [
        {
            "regex": "\\b0[xX][0-9a-fA-F]+\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\\b0[bB][01]+\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\\b0[oO][0-7]+\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\"(\\\\.|[^\"\\\\])*\"",
            "color": "#ce9178"
        },
        {
            "regex": "#[^\n]*",
            "color": "#c586c0"
        }
    ]
}