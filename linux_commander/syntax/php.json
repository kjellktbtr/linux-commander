{
    "name": "PHP",
    "extensions": [
        ".php",
        ".phtml",
        ".php3",
        ".php4",
        ".php5",
        ".php7",
        ".php8",
        ".phps"
    ],
    "case_sensitive": true,
    "keywords": {
        "__halt_compiler": "#569cd6",
        "abstract": "#569cd6",
        "and": "#569cd6",
        "array": "#569cd6",
        "as": "#569cd6",
        "break": "#569cd6",
