        "empty": "#569cd6",
        "enddeclare": "#569cd6",
        "endfor": "#569cd6",
        "endforeach": "#569cd6",
        "endif": "#569cd6",
        "endswitch": "#569cd6",
        "endwhile": "#569cd6",
        "eval": "#569cd6",
        "exit": "#569cd6",
        "extends": "#569cd6",
        "final": "#569cd6",
        "finally": "#569cd6",
        "fn": "#569cd6",
        "for": "#569cd6",
        "foreach": "#569cd6",
        "function": "#569cd6",
        "global": "#569cd6",
        "goto": "#569cd6",
        "if": "#569cd6",
        "implements": "#569cd6",
        "include": "#569cd6",
        "include_once": "#569cd6",
        "instanceof": "#569cd6",
        "insteadof": "#569cd6",
        "interface": "#569cd6",
        "isset": "#569cd6",
        "list": "#569cd6",
        "namespace": "#569cd6",
        "new": "#569cd6",
        "or": "#569cd6",
        "print": "#569cd6",
        "private": "#569cd6",
        "protected": "#569cd6",
        "public": "#569cd6",
        "require": "#569cd6",
        "require_once": "#569cd6",
        "return": "#569cd6",
        "static": "#569cd6",
        "switch": "#569cd6",
        "throw": "#569cd6",
        "trait": "#569cd6",
        "try": "#569cd6",
        "unset": "#569cd6",
        "use": "#569cd6",
        "var": "#569cd6",
        "while": "#569cd6",
        "xor": "#569cd6",
        "yield": "#569cd6",
        "yield from": "#569cd6",
        "true": "#569cd6",
        "false": "#569cd6",
        "null": "#569cd6"
    },
    "builtins": {
        "echo": "#dcdcaa",
        "print": "#dcdcaa",
        "var_dump": "#dcdcaa",
        "var_export": "#dcdcaa",
        "print_r": "#dcdcaa",
        "strlen": "#dcdcaa",
        "strpos": "#dcdcaa",
        "substr": "#dcdcaa",
        "str_replace": "#dcdcaa",
        "preg_match": "#dcdcaa",
        "preg_replace": "#dcdcaa",
        "array_push": "#dcdcaa",
        "array_pop": "#dcdcaa",
        "array_shift": "#dcdcaa",
        "array_unshift": "#dcdcaa",
        "array_merge": "#dcdcaa",
        "array_keys": "#dcdcaa",
        "array_values": "#dcdcaa",
        "count": "#dcdcaa",
        "sizeof": "#dcdcaa",
        "in_array": "#dcdcaa",
        "isset": "#dcdcaa",
        "empty": "#dcdcaa",
        "is_array": "#dcdcaa",
        "is_string": "#dcdcaa",
        "is_int": "#dcdcaa",
        "is_float": "#dcdcaa",
        "is_bool": "#dcdcaa",
        "is_null": "#dcdcaa",
        "is_object": "#dcdcaa",
        "is_resource": "#dcdcaa",
        "is_scalar": "#dcdcaa",
        "is_callable": "#dcdcaa",
        "is_numeric": "#dcdcaa",
        "file_get_contents": "#dcdcaa",
        "file_put_contents": "#dcdcaa",
        "fopen": "#dcdcaa",
        "fclose": "#dcdcaa",
        "fread": "#dcdcaa",
        "fwrite": "#dcdcaa",
        "json_encode": "#dcdcaa",
        "json_decode": "#dcdcaa",
        "date": "#dcdcaa",
        "time": "#dcdcaa",
        "mktime": "#dcdcaa",
        "strtotime": "#dcdcaa",
        "session_start": "#dcdcaa",
        "session_destroy": "#dcdcaa",
        "header": "#dcdcaa",
        "setcookie": "#dcdcaa",
        "$_GET": "#9cdcfe",
        "$_POST": "#9cdcfe",
        "$_REQUEST": "#9cdcfe",
        "$_SERVER": "#9cdcfe",
        "$_SESSION": "#9cdcfe",
        "$_COOKIE": "#9cdcfe",
        "$_FILES": "#9cdcfe",
        "$_ENV": "#9cdcfe",
        "self": "#569cd6",
        "parent": "#569cd6",
        "static": "#569cd6"
    },
    "types": {
        "int": "#4ec9b0",
        "integer": "#4ec9b0",
        "float": "#4ec9b0",
        "double": "#4ec9b0",
        "bool": "#4ec9b0",
        "boolean": "#4ec9b0",
        "string": "#4ec9b0",
        "array": "#4ec9b0",
        "object": "#4ec9b0",
        "resource": "#4ec9b0",
        "callable": "#4ec9b0",
        "mixed": "#4ec9b0",
        "void": "#4ec9b0",
        "never": "#4ec9b0",
        "iterable": "#4ec9b0"
    },
    "string_color": "#ce9178",
    "comment_color": "#6a9955",
    "number_color": "#b5cea8",
    "line_comment": "//",
    "patterns": [
        {
            "regex": "\\b0[xX][0-9a-fA-F]+\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\\b0[bB][01]+\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\\b0[oO][0-7]+\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\\$[a-zA-Z_][a-zA-Z0-9_]*",
            "color": "#9cdcfe"
        },
        {
            "regex": "\"(\\\\.|[^\"\\\\])*\"",
            "color": "#ce9178"
        },
        {
            "regex": "'(\\\\.|[^\\\\'])*'",
            "color": "#ce9178"
        },
        {
            "regex": "<<<[A-Z_][A-Z0-9_]*\\n[\\s\\S]*?\\n[A-Z_][A-Z0-9_]*",
            "color": "#ce9178",
            "multiline": true
        },
        {
            "regex": "#[^\\n]*",
            "color": "#6a9955"
        }
    ]
}