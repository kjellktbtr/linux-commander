    "string_color": "#ce9178",
    "comment_color": "#6a9955",
    "number_color": "#b5cea8",
    "line_comment": "//",
    "patterns": [
        {
            "regex": "\\b0[xX][0-9a-fA-F]+\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\\b0[bB][01]+\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\\b0[oO][0-7]+\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "\\b[0-9]+\\.?[0-9]*([eE][+-]?[0-9]+)?[fF]?\\b",
            "color": "#b5cea8"
        },
        {
            "regex": "r#*\"([^\"#]|\"(?!#*\"))*\"#*",
            "color": "#ce9178"
        },
        {
            "regex": "b?r#*\"([^\"#]|\"(?!#*\"))*\"#*",
            "color": "#ce9178"
        },
        {
            "regex": "b?r#*\"([^\"#]|\"(?!#*\"))*\"#*",
            "color": "#ce9178"
        },
        {
            "regex": "'(\\\\.|[^\\\\'])'",
            "color": "#ce9178"
        },
        {
            "regex": "#\\[[^\\]]*\\]",
            "color": "#dcdcaa"
        }
    ]
